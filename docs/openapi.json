  "components": {
    "schemas": {
      "DashboardOverview": {
        "properties": {
          "property_id": {
            "type": "string",
            "title": "Property Id"
          },
          "data_cutoff": {
            "type": "string",
            "format": "date-time",
            "title": "Data Cutoff"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricCard"
            },
            "type": "array",
            "title": "Metrics"
          },
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/OperatingAlert"
            },
            "type": "array",
            "title": "Alerts"
          },
          "pending_approval_count": {
            "type": "integer",
            "title": "Pending Approval Count"
          }
        },
        "type": "object",
        "required": [
          "property_id",
          "data_cutoff",
          "metrics",
          "alerts",
          "pending_approval_count"
        ],
        "title": "DashboardOverview"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricCard": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "display_value": {
            "type": "string",
            "title": "Display Value"
          },
          "change_display": {
            "type": "string",
            "title": "Change Display"
          },
          "trend": {
            "type": "string",
            "pattern": "^(up|down|flat)$",
            "title": "Trend"
          }
        },
        "type": "object",
        "required": [
          "code",
          "label",
          "value",
          "display_value",
          "change_display",
          "trend"
        ],
        "title": "MetricCard"
      },
      "OperatingAlert": {
        "properties": {
          "severity": {
            "type": "string",
            "pattern": "^(critical|high|medium|low)$",
            "title": "Severity"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "module": {
            "type": "string",
            "title": "Module"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "type": "object",
        "required": [
          "severity",
          "title",
          "description",
          "module",
          "occurred_at"
        ],
        "title": "OperatingAlert"
      },
      "OpsTask": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "state": {
            "$ref": "#/components/schemas/TaskState",
            "default": "PENDING"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "request": {
            "$ref": "#/components/schemas/TaskCreate"
          },
          "recommendation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Recommendation"
              },
              {
                "type": "null"
              }
            ]
          },
          "approval_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Hash"
          },
          "events": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "request"
        ],
        "title": "OpsTask"
      },
      "OpsTaskList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OpsTask"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "OpsTaskList"
      },
      "Recommendation": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "type": "object",
            "title": "Parameters"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
